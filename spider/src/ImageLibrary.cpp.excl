#include "ImageLibrary.h"
namespace spider {
Image *ImageLibrary::get(string uri) {
    return static_cast<Image *>((*this->mImages)[uri]);
}
void ImageLibrary::set(string uri, Image *image) {
    (*this->mImages)[uri] = image;
}
