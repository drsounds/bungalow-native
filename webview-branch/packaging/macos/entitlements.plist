<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime: allow bundled Python libraries not signed by Apple -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network access (Flask sidecar listens on localhost:2855) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Read/write access to user-selected music files -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow reading media in standard Music/Downloads locations -->
    <key>com.apple.security.files.downloads.read-only</key>
    <true/>
</dict>
</plist>
