<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spacify WiX MSI definition.
  AppFiles.wxs is auto-generated by heat.exe during the CI build — do not create it manually.
  $(var.AppVersion) is passed in by candle.exe: -dAppVersion=x.x.x.x
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="Spacify"
           Language="1033"
           Version="$(var.AppVersion)"
           Manufacturer="Spacify"
           UpgradeCode="{E7A3C2F1-4B8D-4E9A-B2C3-D4E5F6A7B8C9}">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Spacify music player"
             Manufacturer="Spacify" />

    <!-- Remove older versions before installing a newer one -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Spacify is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- UI: standard install-dir dialog set -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Feature Id="ProductFeature" Title="Spacify" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

  </Product>

  <!-- Directory layout -->
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">

      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Spacify" />
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="Spacify" />
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop" />

    </Directory>
  </Fragment>

  <!-- Shortcuts (Start Menu + Desktop) -->
  <Fragment>
    <ComponentGroup Id="Shortcuts" Directory="AppMenuFolder">

      <Component Id="StartMenuShortcut"
                 Guid="{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}">
        <Shortcut Id="StartMenuSC"
                  Name="Spacify"
                  Target="[INSTALLFOLDER]spacify-client.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppMenuFolder"
                      Directory="AppMenuFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Spacify"
                       Name="StartMenuInstalled"
                       Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcut"
                 Guid="{B2C3D4E5-F6A7-8901-BCDE-F01234567891}"
                 Directory="DesktopFolder">
        <Shortcut Id="DesktopSC"
                  Name="Spacify"
                  Target="[INSTALLFOLDER]spacify-client.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveDesktopFolder"
                      Directory="DesktopFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Spacify"
                       Name="DesktopInstalled"
                       Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

</Wix>
